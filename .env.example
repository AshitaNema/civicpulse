# CivicPulse Flutter Frontend Environment Variables
# Copy this file to .env and configure local values

# Gemini API Key (Obtain from Google AI Studio - https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=civicpulse-507101
GCP_REGION=us-central1
FIREBASE_STORAGE_BUCKET=civicpulse-507101.firebasestorage.app

# Backend API Endpoint (Cloud Run or Local)
# Local: http://10.0.2.2:8080 (Android emulator) or http://localhost:8080 (iOS simulator)
API_BASE_URL=https://civicpulse-backend-xxxxxxxxxx-uc.a.run.app
